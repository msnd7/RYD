# رابط قاعدة بيانات PostgreSQL (Neon أو Supabase أو Vercel Postgres أو أي مزوّد آخر)
# يُضاف تلقائيًا عند ربط قاعدة بيانات من لوحة Vercel
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# مفتاح توقيع الجلسات — نص عشوائي طويل (٣٢ محرفًا فأكثر)
# ولّده بأمر: openssl rand -hex 32
AUTH_SECRET=
